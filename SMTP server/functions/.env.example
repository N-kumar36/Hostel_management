# SMTP Transport Configuration (Never commit credentials to Git)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password

# Sender Identity
DEFAULT_FROM_NAME="EntireZe Mail Service"
DEFAULT_FROM_EMAIL=your-email@gmail.com

# API Authorization Key for upstream callers
MAIL_API_KEY=your-high-entropy-api-key

# Server Runtime
NODE_ENV=development
PORT=5001
