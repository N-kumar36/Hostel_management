{
  "name": "entireze-mail-api",
  "version": "1.0.0",
  "description": "EntireZe Mail API powered by Firebase Functions v2 and Brevo SMTP",
  "main": "index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "test": "node test-smtp.js && node test-email-api.js"
  },
  "dependencies": {
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.2",
    "nodemailer": "^6.10.0"
  },
  "private": true
}